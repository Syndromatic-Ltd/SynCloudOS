+ }
+
+ /* :not([data-variant]) — this must never leak onto the variant dividers:
+    it ties with their consumer rules on specificity but loads later, and a
+    background SHORTHAND would clobber e.g. the arrow variant's sprite sizing. */
+ [data-nse-theme="com.syndromatic.atmo"] .nse-control-divider:not([data-variant]) {
