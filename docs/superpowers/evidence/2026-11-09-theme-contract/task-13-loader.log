+ /* ============================================================================
+    Push buttons — atmo-button-{medium,light,dark,affirmative,negative}.png
+    Sprite anatomy (52px band): 3px clear top · 2px black stroke · 2px bevel
+    highlight · 38px fill gradient (dark→light) · 2px darker shoe · 2px black
+    stroke · 3px baked drop shadow. Visible pill = 46px, outer radius ≈ 16px.
+    Down band: no bevel, no drop shadow, fast-ramp dark gradient.
+    Disabled band: the up art at ≈40% opacity.
+
+    Layering matters: the sprite's semi-transparent inks composite straight
+    onto the page, so the vector recipe must paint every region exactly once —
+    stacked translucent layers double-darken. Two concentric pill elements:
+      · ::before — outer pill: per-side 2px border = black stroke ring, plus
+        the baked drop shadow. No background.
+      · ::after — inner pill, inset just inside the stroke: per-side 2px
+        border = the RIM ring (bevel top / fill-toned sides / shoe bottom),
+        padding-box gradient = the fill. A border keeps constant thickness
+        around the cap arcs (offset inset-shadows thin to nothing as the arc
+        turns vertical — the "fill pushes the rim out" artefact).
+    Rounded-rect insets share corner centres, so the rings stay concentric.
+    Label paints above both.
+    ========================================================================= */
+
+ [data-nse-theme="com.syndromatic.atmo"] .nse-control-button:where(:not(.nse-control-picker-button)) {
+   position: relative;
+   isolation: isolate;
+   /* Content layout (inline grid, icon margins, label ellipsis) is the shared
+      Atmo control structure's; this rule only sets the vector face's box. */
+   min-width: 76px;
+   --nse-control-minimum-inline-size: 76px;
+   max-width: 100%;
+   margin: 0;
+   height: var(--nse-atmo-control-h);
+   min-height: var(--nse-atmo-control-h);
+   --nse-control-minimum-block-size: var(--nse-atmo-control-h);
+   padding: 0 27px; /* 17px sprite cap + 10px content padding */
+   border: 0;
+   border-image: none;
+   border-radius: 18px;
+   background: transparent;
+   color: #fff;
+   font-family: inherit;
+   font-size: 18px;
+   font-weight: 700;
+   line-height: var(--nse-atmo-control-h);
+   text-shadow: 0 -1px 0 rgba(0, 0, 0, 0.72), 0 1px 1px rgba(255, 255, 255, 0.16);
+   cursor: pointer;
+   user-select: none;
+   -webkit-tap-highlight-color: transparent;
+   /* stroke ring (per-side border colours; measured pairs averaged) */
+   --nse-atmo-btn-stroke-t: rgba(0, 0, 0, 0.57);
+   --nse-atmo-btn-stroke-side: rgba(0, 0, 0, 0.53);
+   --nse-atmo-btn-stroke-b: rgba(0, 0, 0, 0.66);
+   /* rim ring (bevel top / fill-toned sides / shoe bottom) + fill gradient */
+   --nse-atmo-btn-bevel: rgba(167, 167, 167, 0.82);
+   --nse-atmo-btn-rim-side: rgba(125, 125, 125, 0.82);
+   --nse-atmo-btn-shoe: rgba(97, 97, 97, 0.82);
+   --nse-atmo-btn-fill-a: rgba(107, 107, 107, 0.91);
+   --nse-atmo-btn-fill-b: rgba(149, 149, 149, 0.91);
+   --nse-atmo-btn-shadow: 0 1.5px 1.5px rgba(0, 0, 0, 0.24);
+   /* down (pressed/selected) band */
+   --nse-atmo-btn-down-stroke-t: rgba(0, 0, 0, 0.68);
+   --nse-atmo-btn-down-stroke-side: rgba(0, 0, 0, 0.6);
+   --nse-atmo-btn-down-stroke-b: rgba(0, 0, 0, 0.58);
+   --nse-atmo-btn-down-a: rgba(39, 39, 39, 0.87);
+   --nse-atmo-btn-down-a2: rgba(51, 51, 51, 0.87);
+   --nse-atmo-btn-down-b: rgba(68, 68, 68, 0.87);
+   --nse-atmo-btn-down-b2: rgba(64, 64, 64, 0.87);
+   --nse-atmo-btn-down-side: rgba(59, 59, 59, 0.87);
+ }
+
+ /* The vector material owns the final control height. Ordinary action copy
+    can reflow under text zoom; fixed chrome and explicitly sized controls
+    retain their existing metrics. The minimum target remains the theme's. */
+ [data-nse-theme="com.syndromatic.atmo"] .nse-control-button:where(:not(.nse-extended-tool-button, .nse-control-picker-button, .nse-tab-bar-tab, .nse-system-alert-action-button, [data-size])):where(:not(.nse-app-topbar *)) {
+   height: auto;
+   line-height: 1.35;
+ }
+
+ [data-nse-theme="com.syndromatic.atmo"] .nse-control-button:where(:not(.nse-control-picker-button)):focus-visible {
+   outline: none;
+ }
+
+ [data-nse-theme="com.syndromatic.atmo"] .nse-control-button:where(:not(.nse-control-picker-button)):focus-visible::before {
+   box-shadow: var(--nse-atmo-btn-shadow),
+     0 0 0 2px rgba(76, 164, 255, 0.95),
+     0 0 0 4px rgba(108, 188, 255, 0.34),
+     0 0 9px 4px rgba(62, 151, 247, 0.55);
+ }
+
+ /* Disabled labels dim with the face, as the raster skin's do: white tones to
+    56% white, the light tone to #777. The paint rules above restate `color`,
+    so without these a disabled button kept its enabled, full-white label. */
+ [data-nse-theme="com.syndromatic.atmo"] .nse-control-button:where(:not(.nse-control-picker-button)):disabled {
+   cursor: default;
+   color: rgba(255, 255, 255, 0.56);
+ }
+
+ [data-nse-theme="com.syndromatic.atmo"] .nse-control-button:where(:not(.nse-control-picker-button))[data-tone="light"]:disabled {
+   color: #777;
+ }
+
+ [data-nse-theme="com.syndromatic.atmo"] .nse-control-button:where(:not(.nse-control-picker-button))[data-tone="dark"]:disabled {
+   color: rgba(255, 255, 255, 0.56);
+ }
+
+ [data-nse-theme="com.syndromatic.atmo"] .nse-control-button:where(:not(.nse-control-picker-button))::before,
+ [data-nse-theme="com.syndromatic.atmo"] .nse-control-button:where(:not(.nse-control-picker-button))::after {
+   content: "";
+   position: absolute;
+   z-index: -1;
+   pointer-events: none;
+ }
+
+ /* Outer pill: black stroke ring + baked drop shadow + the fill (content-box,
+    so the rim band between stroke and fill stays unpainted for ::after —
+    every translucent ink still composites exactly once). 1px horizontal inset
+    matches the sprite (its outermost column is ~transparent). */
+ [data-nse-theme="com.syndromatic.atmo"] .nse-control-button:where(:not(.nse-control-picker-button))::before {
+   inset: 3px 1px;
+   border-radius: 16px;
+   border: 2px solid;
+   border-color: var(--nse-atmo-btn-stroke-t) var(--nse-atmo-btn-stroke-side) var(--nse-atmo-btn-stroke-b);
+   padding: 2px;
+   background: linear-gradient(var(--nse-atmo-btn-fill-a), var(--nse-atmo-btn-fill-b)) content-box;
+   box-shadow: var(--nse-atmo-btn-shadow);
+ }
+
+ /* Inner pill: the rim as a masked 2px gradient BAND — constant thickness
+    hugging the edge all the way around (equidistant on the arcs, like a
+    border), but painted as a vertical gradient so the bright bevel rolls
+    down the cap arcs (sprite col 6: bright #99–#74 until y≈13) and dissolves
+    into the fill tone, rather than joining side colours in hard diagonals. */
+ [data-nse-theme="com.syndromatic.atmo"] .nse-control-button:where(:not(.nse-control-picker-button))::after {
+   inset: 5px 3px;
+   border-radius: 14px;
+   border: 2px solid transparent;
+   /* Below the bright hold, the stops reproduce the FILL's own ramp at the
+      same absolute heights (band box sits 2px outside the content box), so
+      the band vanishes against the fill at mid-height and only the wrap
+      reads. */
+   background: linear-gradient(
+     var(--nse-atmo-btn-bevel) 0, var(--nse-atmo-btn-bevel) 2px,
