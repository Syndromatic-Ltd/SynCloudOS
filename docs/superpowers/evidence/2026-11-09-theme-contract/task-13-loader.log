+     rgba(2, 2, 2, 0.61) 0,
+     rgba(9, 9, 9, 0.53) 6px,
+     rgba(27, 27, 27, 0.47) 16px,
+     rgba(47, 47, 47, 0.43) 29px,
+     rgba(59, 59, 59, 0.4) calc(100% - 2px),
+     rgba(58, 58, 58, 0.41) 100%
+   );
+   --nse-atmo-rg-ring-sel-t: rgba(2, 2, 2, 0.64);
+   --nse-atmo-rg-ring-sel-s: rgba(23, 23, 23, 0.53);
+   --nse-atmo-rg-ring-sel-b: rgba(58, 58, 58, 0.41);
+   /* Selected cells sit INSET: their own seam/rim columns turn dark and the
+      unselected neighbours cast a soft shadow in from each shared edge.
+      Measured (captured strip cols 84-98): 1px edge = fill ×0.75 (a constant
