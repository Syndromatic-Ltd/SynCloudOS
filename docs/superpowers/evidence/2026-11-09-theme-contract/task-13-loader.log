+ /* Atmo vector control material, with light and dark appearance tokens.
+  * Load after atmo-structure.css. Third-party artwork origins are recorded
+  * in the repository notices; no raster theme is required at runtime. */
+
+ [data-nse-theme="com.syndromatic.atmo"] {
+   --nse-atmo-content-ink: #25303c;
+   --nse-atmo-title-ink: #293645;
+   --nse-atmo-control-ink: #283444;
+   --nse-atmo-label-ink: #4f5d6d;
+   --nse-atmo-window-titlebar-surface: initial;
+   --nse-atmo-control-h: 52px; /* push-button sprite band height */
+   --nse-atmo-bar-h: 50px;     /* toolbar / grouped / radio / field height */
+   --nse-atmo-font: inherit;
+   /* NSE appearance chrome primitives are raster-free vector tokens, not sprite fallback. */
+   --nse-atmo-chrome-surface: linear-gradient(180deg, rgb(255 255 255 / 88%), rgb(208 219 229 / 92%));
+   --nse-atmo-chrome-surface-selected: linear-gradient(180deg, rgb(118 194 247 / 96%), rgb(42 125 198 / 96%));
+   --nse-atmo-chrome-surface-pressed: linear-gradient(180deg, rgb(166 184 199 / 96%), rgb(220 229 236 / 96%));
+   --nse-atmo-chrome-edge: rgb(67 88 107 / 78%);
+   --nse-atmo-chrome-selected-edge: rgb(28 112 185 / 96%);
+   --nse-atmo-tab-label: rgb(20 42 59 / 96%);
+   --nse-atmo-tab-label-selected: rgb(255 255 255 / 98%);
+   --nse-atmo-tab-badge: rgb(182 52 46 / 98%);
+   --nse-atmo-tab-badge-text: rgb(255 255 255 / 98%);
+   /* Shared material vocabulary (plan item 7). The recurring pieces of every
+      traced Atmo surface, as one set of tokens with a dark counterpart:
+      the top light along an upper edge, the glint under a lower rim, the
+      shade of a recess, the text emboss, the selection tint and ring, and
+      the key/rest drop shadows. Newer recipes (windows, collections) are
+      built on these; the traced control recipes keep their measured local
+      values where the source differs. */
+   --nse-atmo-material-top-light: rgba(255, 255, 255, 0.9);
+   --nse-atmo-material-lower-rim: rgba(255, 255, 255, 0.85);
+   --nse-atmo-material-recess: rgba(0, 0, 0, 0.35);
+   --nse-atmo-material-emboss: 0 1px 0 rgba(255, 255, 255, 0.75);
+   --nse-atmo-material-selection-fill: rgba(99, 153, 200, 0.2);
+   --nse-atmo-material-selection-ring: rgba(91, 141, 184, 0.9);
+   --nse-atmo-material-shadow-key: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.3)) drop-shadow(0 12px 22px rgba(0, 0, 0, 0.32));
+   --nse-atmo-material-shadow-rest: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.2)) drop-shadow(0 5px 10px rgba(0, 0, 0, 0.16));
+   /* Atmo's values for the public app content colours (nse-appearance.css), drawn from its own inks. */
+   --nse-colour-secondary-label: var(--nse-atmo-label-ink);
+   --nse-colour-control-background: rgb(255 255 255 / 60%);
+   --nse-colour-grid: rgb(67 88 107 / 28%);
+   --nse-colour-separator: rgb(67 88 107 / 20%);
+   --nse-colour-control-accent: rgb(28 112 185);
+   --nse-colour-selected-control-text: #ffffff;
+   --nse-colour-selected-content-background: var(--nse-atmo-material-selection-fill);
+   --nse-colour-system-red: #a52d28;
+ }
+
+ [data-nse-theme="com.syndromatic.atmo"][data-mode="dark"],
+ [data-nse-theme="com.syndromatic.atmo"] [data-mode="dark"] {
+   --nse-atmo-content-ink: #e3e8ee;
+   --nse-atmo-title-ink: #f1f4f8;
+   --nse-atmo-control-ink: #e7ecf2;
+   --nse-atmo-label-ink: #c3ccd7;
+   --nse-atmo-window-titlebar-surface: linear-gradient(#343b44, #2c333c);
+   --nse-atmo-material-top-light: rgba(255, 255, 255, 0.14);
+   /* The glint under a lower rim must still read on dark metal. */
+   --nse-atmo-material-lower-rim: rgba(255, 255, 255, 0.32);
+   --nse-atmo-material-recess: rgba(0, 0, 0, 0.65);
+   --nse-atmo-material-emboss: 0 -1px 0 rgba(0, 0, 0, 0.55);
+   --nse-atmo-material-selection-fill: rgba(99, 153, 200, 0.24);
+   --nse-atmo-material-selection-ring: rgba(120, 172, 222, 0.9);
+   --nse-atmo-material-shadow-key: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.5)) drop-shadow(0 14px 26px rgba(0, 0, 0, 0.55));
+   --nse-atmo-material-shadow-rest: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.4)) drop-shadow(0 6px 12px rgba(0, 0, 0, 0.35));
+   --nse-colour-secondary-label: var(--nse-atmo-label-ink);
+   --nse-colour-control-background: rgb(255 255 255 / 6%);
+   --nse-colour-grid: rgb(255 255 255 / 11%);
+   --nse-colour-separator: rgb(255 255 255 / 9%);
+   --nse-colour-control-accent: rgb(120 172 222);
+   --nse-colour-selected-control-text: #0d1a2a;
+   --nse-colour-selected-content-background: var(--nse-atmo-material-selection-fill);
+   --nse-colour-system-red: #ff7b72;
