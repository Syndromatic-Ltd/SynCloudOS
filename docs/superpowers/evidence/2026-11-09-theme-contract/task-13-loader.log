+ [data-nse-theme="com.syndromatic.atmo"] .nse-control-alert {
+   --nse-atmo-alert-slice: 44px;
+   --nse-atmo-alert-px: calc(var(--nse-atmo-alert-slice) / 160);
+   --nse-atmo-alert-body: linear-gradient(#737373 0, #565656 calc(var(--nse-atmo-alert-px) * 10), #565656 29%, #242424 93%, #282828 100%);
+   --nse-atmo-alert-rim: rgba(255, 255, 255, 0.07);
+   position: relative;
+   isolation: isolate;
+   padding: var(--nse-atmo-alert-slice);
+   border: 0;
+   border-radius: 0;
+   background: transparent;
+   box-shadow: none;
+   filter: drop-shadow(0 28px 42px rgba(0, 0, 0, 0.64));
+ }
+
+ [data-nse-theme="com.syndromatic.atmo"] .nse-control-alert::before {
+   content: "";
+   position: absolute;
+   z-index: -1;
+   inset:
+     calc(var(--nse-atmo-alert-px) * 27)
+     calc(var(--nse-atmo-alert-px) * 52)
+     calc(var(--nse-atmo-alert-px) * 78);
+   border-radius: calc(var(--nse-atmo-alert-px) * 60);
+   background: var(--nse-atmo-alert-body);
+   box-shadow:
+     inset 0 0 calc(var(--nse-atmo-alert-px) * 8) var(--nse-atmo-alert-rim),
+     0 calc(var(--nse-atmo-alert-px) * 26) calc(var(--nse-atmo-alert-px) * 44) rgba(0, 0, 0, 0.58);
+   pointer-events: none;
+ }
+
+ [data-nse-theme="com.syndromatic.atmo"] .nse-control-alert.is-light {
+   --nse-atmo-alert-body: linear-gradient(#b9b9b9 0, #dfdfdf calc(var(--nse-atmo-alert-px) * 10), #dfdfdf 29%, #939393 93%, #909090 100%);
+   --nse-atmo-alert-rim: rgba(0, 0, 0, 0.075);
+   color: #182332;
+   text-shadow: 0 1px 0 rgba(255, 255, 255, 0.7);
+   background: transparent;
