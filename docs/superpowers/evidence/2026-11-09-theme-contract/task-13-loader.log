+ [data-nse-theme="com.syndromatic.atmo"] .nse-alert-actions .nse-system-alert-action-button.nse-control-button:where(:not(.nse-control-picker-button)) {
+   height: auto;
+   grid-auto-columns: minmax(0, 1fr);
+   padding-block: 10px;
+   min-height: 52px;
+   --nse-control-minimum-block-size: 52px;
+   color: #fff;
+   font-size: 18px;
+   font-weight: 700;
