{
  "id": "com.syndromatic.metro",
  "displayName": "Metro",
  "recipes": [],
  "tokens": {
    "light": {},
    "dark": {}
  },
  "presentation": {
    "peerNavigation": {
      "compact": {
        "kind": "panorama",
        "placement": "block-start",
        "flow": "in-flow",
        "content": "label",
        "overflow": {
          "kind": "scroll"
        }
      },
      "regular": {
        "kind": "panorama",
        "placement": "block-start",
        "flow": "in-flow",
        "content": "label",
        "overflow": {
          "kind": "scroll"
        }
      }
    },
    "chrome": "continuous",
    "login": "plain",
    "tabStyle": "plain",
    "metrics": {
      "navigation": {
        "barBlockSize": 60,
        "edgeGap": 0
      }
    },
    "motion": {
      "peerNavigation": {
        "kind": "slide",
        "durationMs": 300,
        "easing": "decelerate"
      },
      "login": {
        "kind": "slide",
        "durationMs": 180,
        "easing": "decelerate"
      },
      "shell": {
        "kind": "slide",
        "durationMs": 240,
        "easing": "decelerate"
      },
      "overlay": {
        "kind": "slide",
        "durationMs": 180,
        "easing": "decelerate"
      }
    }
  },
  "metadata": {
    "version": "1.0.0",
