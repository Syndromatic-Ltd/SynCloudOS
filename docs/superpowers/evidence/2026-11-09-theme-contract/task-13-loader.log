+     rgba(0, 0, 0, 0.14) 2px, rgba(0, 0, 0, 0.06) 8px,
+     rgba(0, 0, 0, 0) 14px);
+   --nse-atmo-rg-edge-r: linear-gradient(to left,
+     rgba(0, 0, 0, 0.25) 0, rgba(0, 0, 0, 0.25) 1px,
+     rgba(0, 0, 0, 0.14) 2px, rgba(0, 0, 0, 0.06) 8px,
+     rgba(0, 0, 0, 0) 14px);
+   --nse-atmo-rg-cap-l: linear-gradient(to right,
+     rgba(0, 0, 0, 0.14) 0, rgba(0, 0, 0, 0.11) 1px,
+     rgba(0, 0, 0, 0) 8px);
+   --nse-atmo-rg-cap-r: linear-gradient(to left,
+     rgba(0, 0, 0, 0.14) 0, rgba(0, 0, 0, 0.11) 1px,
+     rgba(0, 0, 0, 0) 8px);
+ }
+
+ [data-nse-theme="com.syndromatic.atmo"] .nse-control-radio {
+   position: relative;
+   isolation: isolate;
+   border: 0;
+   border-image: none;
